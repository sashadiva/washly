# Copy this file to `.env` and fill in the values for local development.
# `.env` is gitignored; this example is committed so teammates know which vars to set.

# Local development database connection (host-side Prisma CLI + backend runtime).
# When running inside docker-compose, DATABASE_URL is overridden to db:5432.
DATABASE_URL=""
PORT=5000

# JWT auth. Change JWT_SECRET before any non-local deployment.
JWT_SECRET=""
JWT_EXPIRES_IN=""

# Midtrans Sandbox (Phase 5). Get keys from the Midtrans dashboard Sandbox tab.
# Keep MIDTRANS_IS_PRODUCTION=false for the sandbox. The server key is secret
# (used to create Snap transactions and verify webhook signatures).
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
# Public base URL Midtrans can reach for the webhook. In local dev this is an
# ngrok tunnel, e.g. https://<id>.ngrok-free.app  (set the Midtrans dashboard
# Payment Notification URL to <this>/api/payments/webhook).
APP_WEBHOOK_BASE_URL=""
