# ---------------------------------------------------------------------------
# Root .gitignore for the Washly monorepo (Backend + Frontend).
# Per-directory .gitignore files (Backend/, Frontend/) cover tool-specific
# artifacts; this file is a top-level safety net.
# ---------------------------------------------------------------------------

# Environment variables & secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/
/generated/prisma

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE
.idea/
*.iml
*.swp
*.swo
*~

# Dart / Flutter tooling (also handled in Frontend/.gitignore)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Temp
*.tmp
